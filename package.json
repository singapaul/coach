{
  "name": "coach",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed:check": "node scripts/check-seeds.mjs",
    "db:types": "supabase gen types typescript --local --schema public > supabase/types/database.ts",
    "test": "pnpm --filter @coach/api-tests test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
